{
  "name": "mega-smart-context",
  "version": "0.1.26",
  "megaSmartContext": {
    "countBase": 3
  },
  "private": true,
  "description": "OpenCode 2.0 plugin: the model owns the context window — a bounded memory document, a verbatim working window, and a gated archive instead of append-only history",
  "type": "module",
  "main": "./server.ts",
  "exports": {
    ".": "./server.ts",
    "./server": "./server.ts",
    "./tui": "./tui.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "server.ts",
    "tui.ts",
    "src",
    "scripts",
    "options.json",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "memory"
  ],
  "license": "MIT",
  "author": "Evert Chin (https://github.com/megablue)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megablue/mega-smart-context.git"
  },
  "homepage": "https://github.com/megablue/mega-smart-context#readme",
  "bugs": {
    "url": "https://github.com/megablue/mega-smart-context/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs .",
    "test:install": "node scripts/install-smoke.mjs .",
    "analyze": "node scripts/analyze.mjs",
    "version": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "hooks": "git config core.hooksPath .githooks",
    "plugin:install": "node scripts/install.ts",
    "plugin:install:project": "node scripts/install.ts --project",
    "plugin:uninstall": "node scripts/install.ts --remove",
    "plugin:status": "node scripts/install.ts --status"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.26",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
